<Window x:Class="NineKey.Keyboard.Views.MacroEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:settings="clr-namespace:NineKey.Keyboard.Settings"
        Title="宏管理" Width="520" Height="420"
        Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="自定义宏：名称≤4字，上限8个；支持文本上屏与按键组合。" Margin="0,0,0,8" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="MacroItems">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="4" VerticalAlignment="Center" Margin="2,0" />
                            <ComboBox Grid.Column="1" SelectedItem="{Binding ActionType}" ItemsSource="{Binding ActionTypes, RelativeSource={RelativeSource AncestorType=Window}}" VerticalAlignment="Center" Margin="2,0" />
                            <TextBox Grid.Column="2" Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="2,0" />
                            <Button Grid.Column="3" Content="删除" Click="Delete_Click" Tag="{Binding}" Margin="2,0" Padding="8,2" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock Grid.Row="2" x:Name="LimitText" Foreground="Gray" Margin="0,4" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button x:Name="AddButton" Content="新增" Click="Add_Click" Padding="12,4" Margin="4,0" />
            <Button Content="保存" Click="Save_Click" Padding="12,4" Margin="4,0" />
            <Button Content="取消" Click="Cancel_Click" Padding="12,4" Margin="4,0" />
        </StackPanel>
    </Grid>
</Window>
