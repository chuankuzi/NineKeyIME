<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:NineKey.Keyboard.Views">
    <Style TargetType="{x:Type local:KeyButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ClipToBounds" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:KeyButton}">
                    <Grid ClipToBounds="False">
                        <Border x:Name="KeyBorder"
                                Background="{TemplateBinding KeyBackground}"
                                BorderBrush="{TemplateBinding KeyBorderBrush}"
                                BorderThickness="{TemplateBinding KeyBorderThickness}"
                                CornerRadius="10"
                                ClipToBounds="False"
								RenderTransformOrigin="0.5,0.5">
								<Border.RenderTransform>
                                <ScaleTransform x:Name="KeyScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Digit}"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="22" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding OptionsLabel}"
                                           Foreground="{TemplateBinding SubForeground}"
                                           FontSize="10"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <!-- Flick 提示泡：独立 Popup 图层，不被相邻键遮挡、不被窗口边缘裁剪（P1-10）；
                             §13.18-1：纯展示层 IsHitTestVisible=false，不参与命中测试 -->
                        <Popup x:Name="BubblePopup" AllowsTransparency="True" IsHitTestVisible="False"
                               Placement="Center" PlacementTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                            <Canvas x:Name="PopupCanvas" ClipToBounds="False" IsHitTestVisible="False" />
                        </Popup>
                    </Grid>
                                        <ControlTemplate.Triggers>
                        <Trigger Property="IsPressedVisual" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.05" />
                                        <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.08" />
                                        <DoubleAnimation Storyboard.TargetName="KeyScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.08" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                            <Setter TargetName="KeyBorder" Property="Background" Value="{Binding KeyPressedBackground, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
