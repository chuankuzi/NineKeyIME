<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ApplicationIcon>../../assets/ninekey.ico</ApplicationIcon>
    <RootNamespace>NineKey.Host</RootNamespace>
    <AssemblyName>NineKey.Host</AssemblyName>
    <OutputType>WinExe</OutputType>
    <Description>NineKey IME host: assembly, tray, hotkey, single instance.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\NineKey.Keyboard\NineKey.Keyboard.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\dict\lexicon.bin.gz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>dict\lexicon.bin.gz</TargetPath>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- 安装包合规：licenses/ 下全部许可全文随发布输出进入安装目录（tools/ninekey_setup.iss 打包 SourceDir\*） -->
    <None Include="..\..\licenses\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>licenses\%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>
</Project>
